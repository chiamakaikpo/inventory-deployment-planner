<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Deploy_ToBe" targetNamespace="https://github.com/chiamakaikpo">
  <bpmn:collaboration id="Collab_Deploy_ToBe">
    <bpmn:participant id="Pool_Deploy_ToBe" name="Inventory deployment (to-be)" processRef="Deploy_ToBe"/>
  </bpmn:collaboration>
  <bpmn:process id="Deploy_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Planning workbook">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Deployment planner">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Sales &amp; logistics">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Weekly deployment cycle">
      <bpmn:outgoing>F_s_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Sync: agreed data cut-off, single SAP source">
      <bpmn:incoming>F_s_t1</bpmn:incoming>
      <bpmn:outgoing>F_t1_t2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Rule-based draft allocation (BR-01, BR-02)">
      <bpmn:incoming>F_t1_t2</bpmn:incoming>
      <bpmn:outgoing>F_t2_g1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Exceptions or transfers? (BR-03, BR-04)">
      <bpmn:incoming>F_t2_g1</bpmn:incoming>
      <bpmn:outgoing>F_g1_t3</bpmn:outgoing>
      <bpmn:outgoing>F_g1_t4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t3" name="Review exceptions only">
      <bpmn:incoming>F_g1_t3</bpmn:incoming>
      <bpmn:outgoing>F_t3_t4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t4" name="Align in short S&amp;OP-style huddle">
      <bpmn:incoming>F_g1_t4</bpmn:incoming>
      <bpmn:incoming>F_t3_t4</bpmn:incoming>
      <bpmn:outgoing>F_t4_t5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Dispatch and planned transfers">
      <bpmn:incoming>F_t4_t5</bpmn:incoming>
      <bpmn:outgoing>F_t5_t6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t6" name="Monitor cover, imbalance and service">
      <bpmn:incoming>F_t5_t6</bpmn:incoming>
      <bpmn:outgoing>F_t6_e</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Cycle closed">
      <bpmn:incoming>F_t6_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_s_t1" sourceRef="s" targetRef="t1"/>
    <bpmn:sequenceFlow id="F_t1_t2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="F_t2_g1" sourceRef="t2" targetRef="g1"/>
    <bpmn:sequenceFlow id="F_g1_t3" name="Yes" sourceRef="g1" targetRef="t3"/>
    <bpmn:sequenceFlow id="F_g1_t4" name="No" sourceRef="g1" targetRef="t4"/>
    <bpmn:sequenceFlow id="F_t3_t4" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="F_t4_t5" sourceRef="t4" targetRef="t5"/>
    <bpmn:sequenceFlow id="F_t5_t6" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="F_t6_e" sourceRef="t6" targetRef="e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Deploy_ToBe">
    <bpmndi:BPMNPlane id="Plane_Deploy_ToBe" bpmnElement="Collab_Deploy_ToBe">
      <bpmndi:BPMNShape id="Pool_Deploy_ToBe_di" bpmnElement="Pool_Deploy_ToBe" isHorizontal="true"><dc:Bounds x="0" y="0" width="1424" height="390"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="34" y="0" width="1390" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="34" y="130" width="1390" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="34" y="260" width="1390" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="111" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="221" y="31" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="371" y="31" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="554" y="40" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="671" y="161" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="821" y="291" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="971" y="291" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1121" y="161" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="1311" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_s_t1_di" bpmnElement="F_s_t1"><di:waypoint x="147" y="195"/><di:waypoint x="184" y="195"/><di:waypoint x="184" y="65"/><di:waypoint x="221" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t1_t2_di" bpmnElement="F_t1_t2"><di:waypoint x="337" y="65"/><di:waypoint x="371" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t2_g1_di" bpmnElement="F_t2_g1"><di:waypoint x="487" y="65"/><di:waypoint x="554" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_t3_di" bpmnElement="F_g1_t3"><di:waypoint x="604" y="65"/><di:waypoint x="638" y="65"/><di:waypoint x="638" y="195"/><di:waypoint x="671" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_t4_di" bpmnElement="F_g1_t4"><di:waypoint x="579" y="90"/><di:waypoint x="579" y="325"/><di:waypoint x="821" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t3_t4_di" bpmnElement="F_t3_t4"><di:waypoint x="787" y="195"/><di:waypoint x="804" y="195"/><di:waypoint x="804" y="325"/><di:waypoint x="821" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t4_t5_di" bpmnElement="F_t4_t5"><di:waypoint x="937" y="325"/><di:waypoint x="971" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t5_t6_di" bpmnElement="F_t5_t6"><di:waypoint x="1087" y="325"/><di:waypoint x="1104" y="325"/><di:waypoint x="1104" y="195"/><di:waypoint x="1121" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t6_e_di" bpmnElement="F_t6_e"><di:waypoint x="1237" y="195"/><di:waypoint x="1311" y="195"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
