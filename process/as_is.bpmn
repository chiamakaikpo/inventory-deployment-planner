<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Deploy_AsIs" targetNamespace="https://github.com/chiamakaikpo">
  <bpmn:collaboration id="Collab_Deploy_AsIs">
    <bpmn:participant id="Pool_Deploy_AsIs" name="Inventory deployment (as-is)" processRef="Deploy_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="Deploy_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Deployment planner">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Sales">
        <bpmn:flowNodeRef>a4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Logistics">
        <bpmn:flowNodeRef>a5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>a6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Weekly deployment cycle">
      <bpmn:outgoing>F_s_a1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="a1" name="Extract stock and sales data from SAP">
      <bpmn:incoming>F_s_a1</bpmn:incoming>
      <bpmn:outgoing>F_a1_a2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a2" name="Merge data manually in spreadsheets">
      <bpmn:incoming>F_a1_a2</bpmn:incoming>
      <bpmn:outgoing>F_a2_a3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a3" name="Allocate by judgement, no shared rules">
      <bpmn:incoming>F_a2_a3</bpmn:incoming>
      <bpmn:outgoing>F_a3_a4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a4" name="Review every SKU and depot with planner">
      <bpmn:incoming>F_a3_a4</bpmn:incoming>
      <bpmn:outgoing>F_a4_a5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="a5" name="Dispatch from breweries to depots">
      <bpmn:incoming>F_a4_a5</bpmn:incoming>
      <bpmn:outgoing>F_a5_g1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Depot short?">
      <bpmn:incoming>F_a5_g1</bpmn:incoming>
      <bpmn:outgoing>F_g1_a6</bpmn:outgoing>
      <bpmn:outgoing>F_g1_e</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="a6" name="Firefight: emergency transfer after the fact">
      <bpmn:incoming>F_g1_a6</bpmn:incoming>
      <bpmn:outgoing>F_a6_e</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Cycle closed">
      <bpmn:incoming>F_g1_e</bpmn:incoming>
      <bpmn:incoming>F_a6_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_s_a1" sourceRef="s" targetRef="a1"/>
    <bpmn:sequenceFlow id="F_a1_a2" sourceRef="a1" targetRef="a2"/>
    <bpmn:sequenceFlow id="F_a2_a3" sourceRef="a2" targetRef="a3"/>
    <bpmn:sequenceFlow id="F_a3_a4" sourceRef="a3" targetRef="a4"/>
    <bpmn:sequenceFlow id="F_a4_a5" sourceRef="a4" targetRef="a5"/>
    <bpmn:sequenceFlow id="F_a5_g1" sourceRef="a5" targetRef="g1"/>
    <bpmn:sequenceFlow id="F_g1_a6" name="Yes" sourceRef="g1" targetRef="a6"/>
    <bpmn:sequenceFlow id="F_g1_e" name="No" sourceRef="g1" targetRef="e"/>
    <bpmn:sequenceFlow id="F_a6_e" sourceRef="a6" targetRef="e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Deploy_AsIs">
    <bpmndi:BPMNPlane id="Plane_Deploy_AsIs" bpmnElement="Collab_Deploy_AsIs">
      <bpmndi:BPMNShape id="Pool_Deploy_AsIs_di" bpmnElement="Pool_Deploy_AsIs" isHorizontal="true"><dc:Bounds x="0" y="0" width="1424" height="390"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="34" y="0" width="1390" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="34" y="130" width="1390" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="34" y="260" width="1390" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="111" y="47" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a1_di" bpmnElement="a1"><dc:Bounds x="221" y="31" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a2_di" bpmnElement="a2"><dc:Bounds x="371" y="31" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a3_di" bpmnElement="a3"><dc:Bounds x="521" y="31" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a4_di" bpmnElement="a4"><dc:Bounds x="671" y="161" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a5_di" bpmnElement="a5"><dc:Bounds x="821" y="291" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="1004" y="300" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="a6_di" bpmnElement="a6"><dc:Bounds x="1121" y="291" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="1311" y="47" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_s_a1_di" bpmnElement="F_s_a1"><di:waypoint x="147" y="65"/><di:waypoint x="221" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_a1_a2_di" bpmnElement="F_a1_a2"><di:waypoint x="337" y="65"/><di:waypoint x="371" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_a2_a3_di" bpmnElement="F_a2_a3"><di:waypoint x="487" y="65"/><di:waypoint x="521" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_a3_a4_di" bpmnElement="F_a3_a4"><di:waypoint x="637" y="65"/><di:waypoint x="654" y="65"/><di:waypoint x="654" y="195"/><di:waypoint x="671" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_a4_a5_di" bpmnElement="F_a4_a5"><di:waypoint x="787" y="195"/><di:waypoint x="804" y="195"/><di:waypoint x="804" y="325"/><di:waypoint x="821" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_a5_g1_di" bpmnElement="F_a5_g1"><di:waypoint x="937" y="325"/><di:waypoint x="1004" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_a6_di" bpmnElement="F_g1_a6"><di:waypoint x="1054" y="325"/><di:waypoint x="1121" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_e_di" bpmnElement="F_g1_e"><di:waypoint x="1029" y="300"/><di:waypoint x="1029" y="65"/><di:waypoint x="1311" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_a6_e_di" bpmnElement="F_a6_e"><di:waypoint x="1237" y="325"/><di:waypoint x="1274" y="325"/><di:waypoint x="1274" y="65"/><di:waypoint x="1311" y="65"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
